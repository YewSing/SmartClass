DATABASE_URL=postgresql+asyncpg://smartclass:smartclass_dev@localhost:5432/smartclass
SECRET_KEY=dev-secret-change-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
INTERNAL_API_KEY=worker-shared-secret-change-in-production
FACE_MATCH_THRESHOLD=0.40
INSIGHTFACE_MODEL=buffalo_sc
FACE_VOTE_THRESHOLD=3
FACE_COOLDOWN_SECONDS=30

# Attendance (FR-302): a first face recognition more than this many minutes after the
# class's effective start is recorded as Late instead of Present.
ATTENDANCE_LATE_AFTER_MINUTES=15

# Moodle (SPeCTRUM simulation) - see backend/moodle/README.md
MOODLE_URL=http://localhost:8080
MOODLE_TOKEN=
KB_SYNC_INTERVAL_SECONDS=300

# AI Learning Assistant (Module 8) - any OpenAI-compatible provider.
# Leave LLM_API_KEY empty to disable chat (endpoints return 503). Never commit a real key.
#   DeepSeek: LLM_BASE_URL=https://api.deepseek.com                                  LLM_MODEL=deepseek-chat
#   Gemini:   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-3.5-flash
#             LLM_REASONING_EFFORT=low   (Gemini only; leave empty for DeepSeek)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_REASONING_EFFORT=
LLM_TIMEOUT_SECONDS=45
ASSISTANT_REWRITE_FOLLOWUPS=true

# Local embedding model (fastembed/ONNX, 384 dims). Empty cache dir -> ~/.cache/smartclass/fastembed
KB_EMBED_MODEL=BAAI/bge-small-en-v1.5
KB_EMBED_CACHE_DIR=
