{
  "expo": {
    "name": "SmartClass Student",
    "slug": "smartclass-student",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": { "backgroundColor": "#1B6EF3" },
    "android": { "adaptiveIcon": { "backgroundColor": "#1B6EF3" }, "package": "my.um.smartclass.student" },
    "ios": { "supportsTablet": false, "bundleIdentifier": "my.um.smartclass.student" },
    "plugins": [
      ["expo-camera", {
        "cameraPermission": "SmartClass uses the camera to take your selfies and matric card photo for face enrolment.",
        "microphonePermission": false,
        "recordAudioAndroid": false
      }]
    ]
  }
}
